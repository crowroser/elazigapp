# Firebase Configuration Example
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=elazigapp.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=elazigapp
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=elazigapp.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Google Sign-In Configuration Example
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_GOOGLE_ANDROID_CLIENT_ID


# WeatherAPI (https://www.weatherapi.com)
EXPO_PUBLIC_WEATHER_API_KEY=YOUR_WEATHERAPI_KEY
