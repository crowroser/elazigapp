.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase config
google-services.json

# Network captures and logs
*.har
*.log

# keystores
*.keystore


# native-widgets: sürüm kontrolüne yalnızca config plugin'in kopyaladığı widget kaynakları girer
# (kopyalanmış Android projesinin geri kalanı: gradle, mipmap, MainActivity, debug.keystore vb. hariç)
native-widgets/android/*
!native-widgets/android/app/
native-widgets/android/app/*
!native-widgets/android/app/src/
native-widgets/android/app/src/*
!native-widgets/android/app/src/main/
native-widgets/android/app/src/main/*
!native-widgets/android/app/src/main/java/
!native-widgets/android/app/src/main/res/
native-widgets/android/app/src/main/java/com/crowroser/elazigsehir/MainActivity.kt
native-widgets/android/app/src/main/java/com/crowroser/elazigsehir/MainApplication.kt
native-widgets/android/app/src/main/res/*
!native-widgets/android/app/src/main/res/drawable/
native-widgets/android/app/src/main/res/drawable/*
!native-widgets/android/app/src/main/res/drawable/widget_*.xml
!native-widgets/android/app/src/main/res/layout/
!native-widgets/android/app/src/main/res/xml/

# geçici test betikleri
__*.ts
__*.mjs
probe_*.mjs
